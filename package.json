{
  "name": "opencode-project-panel",
  "version": "0.1.3",
  "type": "module",
  "description": "OpenCode TUI plugin with a file manager and permissions panels",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenkumi/opencode-project-panel.git"
  },
  "homepage": "https://github.com/chenkumi/opencode-project-panel#readme",
  "bugs": {
    "url": "https://github.com/chenkumi/opencode-project-panel/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "file-manager",
    "permissions",
    "mcp"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build && bun run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/keymap": "0.4.3",
    "@opentui/solid": "0.4.3",
    "jsonc-parser": "^3.3.1",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@types/bun": "latest",
    "typescript": "^7.0.0"
  }
}
